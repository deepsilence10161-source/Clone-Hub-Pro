<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for by every app that offers Google sign-in; the probe reports what the clone sees. -->
    <!-- The WebView probe loads a real HTTPS page, so the fixture needs its own network permission:
         measured in run 43690036509, its absence answers every load with net::ERR_CACHE_MISS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- A separate, ordinary user app used only to prove the complete clone flow. -->
        <activity
            android:name="com.clonehub.advanced.fixture.CloneFixtureActivity"
            android:exported="true"
            android:label="Clone Hub Fixture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The WebView sign-in probe: the path a real web-based app uses for "Continue with Google".
          Measured native vs inside a clone; see WebViewSignInProbe.java for what each marker means.
        -->
        <activity
            android:name="com.clonehub.advanced.fixture.WebViewSignInProbe"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="WebView Sign-in Probe" />

        <!--
          A test-only authenticator under the real com.google account type.

          The device gates run on an image with no Play services, so there is no authenticator for
          com.google and an app's Google sign-in cannot reach the account manager at all — which is
          why end-to-end sign-in could only ever be reported as NOT TESTED. With this registered, a
          token request from inside a clone travels the real path (app -> AccountManagerService ->
          authenticator -> response) and returns a fake token that is labelled as such.
        -->
        <service
            android:name="com.clonehub.advanced.fixture.TestGoogleAuthenticator$AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_google_authenticator" />
        </service>

        <!-- Same authenticator implementation, different account type: see
             res/xml/test_probe_authenticator.xml for why this exists. -->
        <service
            android:name="com.clonehub.advanced.fixture.TestGoogleAuthenticator$ProbeAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_probe_authenticator" />
        </service>

</application>
</manifest>
