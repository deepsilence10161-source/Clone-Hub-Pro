<?xml version="1.0" encoding="utf-8"?>
<!--
  The update screen. One column, scrollable, because the honest answer is a few lines long: what is
  installed, what is offered, which key signed it, whether this device accepts an installer intent,
  and the digest the bytes were checked against. Text is selectable where it is evidence (fingerprint,
  digest, file path) so a user can copy it into a report instead of retyping it from a screenshot.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_normal"
        android:paddingEnd="@dimen/margin_normal"
        android:paddingTop="@dimen/margin_normal"
        android:paddingBottom="@dimen/fab_clearance">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivUpdateIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/update_icon_description" />

            <TextView
                android:id="@+id/tvUpdateInstalled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="@string/update_installed_placeholder" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUpdateOffered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_normal"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/update_checking" />

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressUpdate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:max="100"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_normal"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUpdatePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_normal"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btnUpdateCheck"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/margin_normal"
            android:backgroundTint="@color/surface_dark"
            android:textColor="@color/white"
            android:text="@string/update_action_check" />

        <Button
            android:id="@+id/btnUpdateInstall"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/margin_small"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:text="@string/update_action_install" />

        <Button
            android:id="@+id/btnUpdateOpenFile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/margin_small"
            android:backgroundTint="@color/surface_dark"
            android:textColor="@color/white"
            android:text="@string/update_action_open_file"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnUpdatePermission"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/margin_small"
            android:backgroundTint="@color/surface_dark"
            android:textColor="@color/colorPrimary"
            android:text="@string/update_action_allow_installs"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
