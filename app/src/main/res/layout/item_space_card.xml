<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSpace"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/space_card_margin"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="@dimen/dp_12"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false">

    <!--
      Phone layout: the card is the full page of the pager, so its content uses the available
      height instead of a fixed size. The header row is a single line that cannot overflow at
      360dp: badge on the start, menu button on the end, both 48dp touch targets.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_card_padding"
        android:paddingEnd="@dimen/space_card_padding"
        android:paddingTop="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_small">

        <RelativeLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target">

            <TextView
                android:id="@+id/tvSpaceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_permission_step"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="180dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Space 1"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnSpaceMenu"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_space_menu"
                android:padding="12dp"
                android:src="@drawable/ic_action_menu"
                app:tint="@color/colorPrimary" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/margin_small"
            android:scrollbars="vertical" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
