<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSpace"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/space_card_margin"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="@dimen/dp_12"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false">

    <!--
      Phone layout: the card is the full page of the pager, so its content uses the available
      height instead of a fixed size. The header row is a single line that cannot overflow at
      360dp: badge on the start, menu button on the end, both 48dp touch targets.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_card_padding"
        android:paddingEnd="@dimen/space_card_padding"
        android:paddingTop="@dimen/margin_small"
        android:paddingBottom="@dimen/margin_small">

        <RelativeLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target">

            <TextView
                android:id="@+id/tvSpaceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_permission_step"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="180dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Space 1"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnSpaceMenu"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_space_menu"
                android:padding="12dp"
                android:src="@drawable/ic_action_menu"
                app:tint="@color/colorPrimary" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/grid_min_height"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/margin_small"
            android:scrollbars="vertical" />

        <!--
          Empty-space state.

          Measured on the phone UI matrix (run 43592167654, screenshots at 320x640 and 411x891):
          when this sentence was centred over the card as a FrameLayout child, it drew *through*
          the Add tile on a short card — "Add App" and the sentence shared the same pixels. It is a
          sibling of the grid now, in the card's own column, so it is laid out below the tiles and
          cannot overlap them, and it keeps clear of the floating button that hangs over the card's
          bottom corner. Zero-height while hidden.
        -->
        <TextView
            android:id="@+id/tvEmptySpaceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_card_padding_large"
            android:layout_marginEnd="@dimen/space_card_padding_large"
            android:layout_marginBottom="@dimen/empty_hint_bottom_space"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/empty_space_hint"
            android:textColor="@color/text_secondary_dark"
            android:textSize="@dimen/empty_hint_text_size"
            android:visibility="gone" />
    </LinearLayout>

    </FrameLayout>
</androidx.cardview.widget.CardView>
