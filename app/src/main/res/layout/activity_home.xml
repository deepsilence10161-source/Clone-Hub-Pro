<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:paddingEnd="0dp"
            app:title="@string/app_name"
            app:titleMarginStart="0dp"
            app:titleTextColor="@color/white">

            <!--
              Space selector: "< 1 >" on a phone. The left chevron is hidden on the first space
              and the right one on the last space, and both are hidden when there is only one
              space — arrows that cannot do anything read as broken controls (measured on the
              320dp screenshot of the UI matrix, run 43203694595). The menu is a compact icon,
              and the subtitle keeps the "which space" answer in words.
            -->
            <LinearLayout
                android:id="@+id/spaceContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/margin_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnPrevSpace"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_previous_space"
                    android:padding="10dp"
                    android:src="@drawable/baseline_arrow_left_24"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvSpaceIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="24dp"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnNextSpace"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_next_space"
                    android:padding="10dp"
                    android:src="@drawable/baseline_arrow_right_24"
                    app:tint="@color/colorPrimary" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@color/divider" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnOverflow"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_more_options"
                    android:padding="12dp"
                    android:src="@drawable/ic_action_menu"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!--
          One short line, only while a space holds clones: the long paragraph pushed the space card
          down on a 320dp phone and said more than a user needs in a hint.
        -->
        <TextView
            android:id="@+id/tvCapacityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="@dimen/margin_normal"
            android:paddingEnd="@dimen/margin_normal"
            android:paddingTop="4dp"
            android:paddingBottom="0dp"
            android:text="@string/clone_capacity_note"
            android:textColor="@color/text_secondary_dark"
            android:textSize="11sp"
            android:visibility="gone" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerSpaces"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/home_grid_padding"
            android:paddingEnd="@dimen/home_grid_padding"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/fab_clearance" />

    </LinearLayout>

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />

    <!-- Floating Action Button for Adding Apps -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/margin_normal"
        android:layout_marginBottom="@dimen/fab_clearance"
        android:backgroundTint="@color/colorPrimary"
        android:src="@drawable/ic_action_add_24"
        app:elevation="6dp"
        app:fabSize="normal"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
